{
  "manifest_version": 3,
  "name": "Christian's Google Meet Enhancements",
  "version": "1.0.0",
  "description": "Small fixes for Google Meet. Mute one meeting's sound without touching the others, and join every meeting with camera and mic off.",
  "minimum_chrome_version": "126",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
